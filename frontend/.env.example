# Warranto frontend — environment template.
# Copy to frontend/.env for local development (frontend/.env is git-ignored).
#
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put API keys, database URIs, JWT secrets or SMTP passwords here —
# anything in this file ends up in the public JavaScript bundle.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
# Local development (backend running with `npm run dev` in ../backend):
VITE_API_BASE_URL=http://localhost:5000/api

# Production (Vercel → Settings → Environment Variables):
# replace with your deployed Render backend URL, including the /api suffix, e.g.
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api
# Vite bakes this value in at build time, so redeploy after changing it.

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# The same OAuth "Web application" client id configured in the backend
# (GOOGLE_CLIENT_ID). It is a public identifier — it is expected to be visible in
# the browser. Do not put the client secret anywhere in this app.
# Leave empty to hide the "Continue with Google" option.
VITE_GOOGLE_CLIENT_ID=

# Shown in the UI. Optional — defaults to "Warranto".
VITE_APP_NAME=Warranto
