# Warranto API — environment template
# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by Git — never commit real credentials.

# Port the API listens on (frontend expects http://localhost:5000/api).
# On Render, leave this unset — the platform injects PORT.
PORT=5000

# "production" on Render. Locally keep development.
NODE_ENV=development

# MongoDB Atlas connection string — replace <user>, <password> and <cluster>.
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
# Remember to allow the host in the Atlas Network Access list.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/warranto?retryWrites=true&w=majority

# Secret used to sign JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Allowed browser origin(s) — the frontend allowed to call this API.
# Local development:
CLIENT_URL=http://localhost:5173
# Production (Render): the deployed frontend origin, no trailing slash, e.g.
#   CLIENT_URL=https://<your-vercel-app>.vercel.app
# Several origins can be comma-separated. An entry may contain `*` as a wildcard
# (matches any characters except `/`), e.g. https://*.vercel.app allows the
# production alias and every preview deployment in one value:
#   CLIENT_URL=https://warranto.vercel.app,https://*.vercel.app
# Local ports 5173 (npm run dev) and 4173 (npm run preview) stay allowed
# automatically unless NODE_ENV=production.

# Optional: how long a login stays valid (default 7d)
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# The OAuth 2.0 "Web application" client id from Google Cloud Console
# (APIs & Services → Credentials). It is a public value; the matching client
# secret is NOT needed for this flow — never put one here.
#
# Setup:
#   1. Google Cloud Console → create or select a project.
#   2. APIs & Services → OAuth consent screen → External (or Internal for a
#      Workspace org); set the app name and support email.
#   3. Credentials → Create credentials → OAuth client ID → Web application.
#   4. Authorized JavaScript origins (origins only, no paths):
#        http://localhost:5173
#        https://<your-vercel-app>.vercel.app
#      Redirect URIs are not required for the ID-token flow.
#   5. While the consent screen is in "Testing", add the Google accounts that
#      may sign in under Audience → Test users.
#
# Leave this empty to disable Google sign-in: the API keeps working, the
# endpoint answers 501, and the UI hides the button.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Bill file storage
# ---------------------------------------------------------------------------
# "auto" (default) uses Cloudinary when the three credentials below are set,
# otherwise it writes to BILL_STORAGE_DIR on local disk.
# IMPORTANT: Render's filesystem is ephemeral — locally stored bills are lost on
# every deploy/restart, so set the Cloudinary credentials in production.
BILL_STORAGE_DRIVER=auto
BILL_STORAGE_DIR=storage

# From the Cloudinary dashboard. Never commit these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email reminders (Nodemailer)
# ---------------------------------------------------------------------------
# Leave MAIL_MODE empty to disable email entirely: the scheduler logs why it is
# idle and no other feature is affected.
# Required when MAIL_MODE is smtp. Get these from your mail provider.
# Never commit real credentials — backend/.env is git-ignored.
MAIL_MODE=
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: a test address that receives every scheduled reminder, regardless
# of the real recipient. Useful for staging / pre-flight checks. Leave empty
# to send to the user's real email address.
MAIL_TEST_TO=

# Optional: how often the reminder scheduler runs (node-cron expression).
# Default: every 30 minutes. Changing this requires a server restart.
# See backend/lib/reminderScheduler.js for the exact schedule.
REMINDER_SCHEDULE=*/30 * * * *
